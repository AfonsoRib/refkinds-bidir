kind fun RA::{ s :: Rec |  ~ empty(s) } -> fun RB::{z::Rec | (labSet(z) # labSet(RA))  } 
   ->  ([|headlb(RA)  :  ref (head(RA))|] @ RB) ;; 

kind
letrec GType :: Pi S::{r::Rec | ~ (empty r) }.
                Pi V::{v::Rec | labSet(v) # labSet(S) }. Fun
       =
       fun S::{r::Rec | ~ (empty r) } -> 
       fun V::{v::Rec | labSet(v) # labSet(S) } -> 
        ( (head(S)) -> (if ~ (empty (tail(S))) then (GType (tail(S)) ([|headlb S : ref (head(S)) |]@V)) else ([|headlb S : ref (head(S)) |]@V)))
in
 (GType [|`s : int, `q : bool, `f:bool->int |] [| |])
end;;

type
letrec GType :: Pi S::{r::Rec | ~ (empty r) }.
                Pi V::{v::Rec | labSet(v) # labSet(S) }. Fun
       =
       fun S::{r::Rec | ~ (empty r) } -> 
       fun V::{v::Rec | labSet(v) # labSet(S) } -> 
        ( (head(S)) -> if ~ (empty (tail(S))) then 
                           (GType (tail(S)) ([|headlb S : ref (head(S)) |]@V)) 
                         else ([|headlb S : ref (head(S)) |]@V))
in
letrec genConstr  : 
     All S::{r::Rec | ~ (empty r) }.
     All V::{v::Rec | labSet(v) # labSet(S) }.(V->(GType S V)) = 
     fun S::{ r::Rec | ~ (empty r) } ->
     fun V::{ v::Rec | labSet(v) # labSet(S) } -> 
     fun v:V -> 
     fun x:(head S) -> 
       if ~ (empty (tail(S))) then
                          (genConstr (tail(S)) ([| headlb S : ref (head(S))|]@V) ([(headlb S) = new x]@v)) 
                      else ([(headlb S) = new x]@v)
in
   (genConstr  [|`s : int, `q : bool |] [| |])
end
end;;


type 
let Id::(Pi X::Type.Type) = fun X::Type -> (X->bool) in
  letrec Map::Pi R::Rec.Pi G::(Pi Y::Type.Type).{r::Rec | labSet(r) == labSet(R)} =
     fun  R::Rec -> fun G::(Pi Y::Type.Type) -> 
       if ~ empty R then ([|headlb(R):(G (head(R)))|] @ (Map (tail(R)) G)) else [||]
  in 
   let r : (Map [|`p:bool|] Id) = [`p = fun x:bool -> ~ x ] in ( (head r) true ) end
end
end;;


type 

  let Proj :: Pi L :: Lab.Pi t :: { r :: Rec | L inl labSet(r) } . Type =
  fun L::Lab -> 
  letrec G :: Pi t :: { r :: Rec | L inl labSet(r) } .Type = 
    fun t :: { r :: Rec | L inl labSet(r) } -> 
      if (headlb(t) == L) then head(t) else (G (tail(t)))
  in G end
  in

  letrec proj : All L::Lab. All t :: { r :: Rec | L inl labSet(r) }. (t -> (Proj L t)) =
  fun  L::Lab -> fun t :: { r :: Rec | L inl labSet(r) } -> fun r:t ->
    if (headlb(t) == L) then head(r) else (proj L (tail(t)) tail(r))
  in

  let XForm::(Pi X::Type. { r :: Rec | r == [|`tag:string,`toString: (X -> string) |]  })  = 
     fun X::Type -> [|`tag:string,`toString: (X -> string) |]  
  in

  letrec Map::Pi R::Rec.Pi G::(Pi Y::Type.Type).{r::Rec | labSet(r) == labSet(R)} =
          fun  R::Rec -> fun G::(Pi Y::Type.Type) -> 
           if ~ empty R then 
              ([|headlb(R):(G (head(R)))|] @ (Map (tail(R)) G))
           else [||] 
  in

  let MkTableType :: Pi R::Rec.{r::Rec | labSet(r) == labSet(R)} = 
               fun R :: Rec -> ( Map R XForm )
  in

  letrec MkTable : All R::Rec. ((MkTableType R) -> (R -> string)) = 
             fun R :: Rec -> fun m:(MkTableType R) -> fun r:R -> 
               (if ~ (empty R) then "<tr><th>" ^
                  (proj `tag (XForm (head R)) (head m)) ^ 
                  "<\th><td>" ^
                 ( (proj `toString (XForm (head R)) (head m)) (head r)) ^ 
                  "<\td><\tr>" ^
                  (MkTable (tail(R)) (tail(m)) (tail(r)))
                else ""
               )
            in
              
             MkTable 

           end
        end
   end
end
end
end;;

type 

  let Proj :: Pi L :: Lab.Pi t :: { r :: Rec | L inl labSet(r) } . Type =
  fun L::Lab -> 
  letrec G :: Pi t :: { r :: Rec | L inl labSet(r) } .Type = 
    fun t :: { r :: Rec | L inl labSet(r) } -> 
      if (headlb(t) == L) then head(t) else (G (tail(t)))
  in G end
  in

  letrec proj : All L::Lab. All t :: { r :: Rec | L inl labSet(r) }. (t -> (Proj L t)) =
  fun  L::Lab -> fun t :: { r :: Rec | L inl labSet(r) } -> fun r:t ->
    if (headlb(t) == L) then head(r) else (proj L (tail(t)) tail(r))
  in

  let XForm::(Pi X::Type. { r :: Rec | r == [|`tag:string,`toString: (X -> string) |]  })  = 
     fun X::Type -> [|`tag:string,`toString: (X -> string) |]  
  in

  letrec Map::Pi R::Rec.Pi G::(Pi Y::Type.Type).{r::Rec | labSet(r) == labSet(R)} =
          fun  R::Rec -> fun G::(Pi Y::Type.Type) -> 
           if ~ empty R then 
              ([|headlb(R):(G (head(R)))|] @ (Map (tail(R)) G))
           else [||] 
  in

  let MkTableType :: Pi R::Rec.{r::Rec | labSet(r) == labSet(R)} = 
               fun R :: Rec -> ( Map R XForm )
  in

  letrec MkTable : All R::Rec. ((MkTableType R) -> (R -> string)) = 
             fun R :: Rec -> fun m:(MkTableType R) -> fun r:R -> 
               (if ~ (empty R) then "<tr><th>" ^
                  (proj `tag (XForm (head R)) (head m)) ^ 
                  "<\th><td>" ^
                 ( (proj `toString (XForm (head R)) (head m)) (head r)) ^ 
                  "<\td><\tr>" ^
                  (MkTable (tail(R)) (tail(m)) (tail(r)))
                else ""
               )
            in
              
             MkTable [|`name:string,`age: int |] 
                     [`name = [`tag = "NAME",`toString = (fun x:string -> x)],`age = [`tag = "AGE",`toString = (fun x:int -> "20")]] 
                     [`name = "joe",`age = 20]

           end
        end
   end
end
end

  fun L::Lab -> 
  letrec G :: Pi t :: { r :: Rec | L inl labSet(r) } .Type = 
    fun t :: { r :: Rec | L inl labSet(r) } -> 
      if (headlb(t) == L) then head(t) else (G (tail(t)))
  in G end
in
 Proj `p [|`p:bool|]
